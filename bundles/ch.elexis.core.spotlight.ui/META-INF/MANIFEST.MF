Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Spotlight Like Single Line Search UI
Bundle-SymbolicName: ch.elexis.core.spotlight.ui;singleton:=true
Bundle-Version: 3.13.0.qualifier
Bundle-Vendor: elexis.info
Require-Bundle: ch.elexis.core.spotlight;bundle-version="3.10.0",
 ch.elexis.core.ui.e4;bundle-version="3.10.0",
 ch.elexis.core.ui.icons;bundle-version="3.3.0"
Bundle-RequiredExecutionEnvironment: JavaSE-21
Import-Package: ch.elexis.core.documents,
 ch.elexis.core.pdfbox.ui.parts,
 ch.elexis.core.pdfbox.ui.parts.handlers,
 jakarta.inject;version="1.0.0",
 org.eclipse.e4.ui.services,
 org.slf4j;version="1.6.6"
Automatic-Module-Name: ch.elexis.core.spotlight.ui
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Export-Package: ch.elexis.core.spotlight.ui,
 ch.elexis.core.spotlight.ui.controls,
 ch.elexis.core.spotlight.ui.internal
Service-Component: OSGI-INF/ch.elexis.core.spotlight.ui.controls.detail.PatientSpotlightResultEntryDetailCompositeContributor.xml,
 OSGI-INF/ch.elexis.core.spotlight.ui.internal.SpotlightResultEntryDetailCompositeService.xml,
 OSGI-INF/ch.elexis.core.spotlight.ui.internal.ready.SpotlightReadyService.xml
